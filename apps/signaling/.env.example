# Port to listen on (most hosts set this for you)
PORT=4000

# Web app origins allowed to connect, comma-separated
CORS_ORIGIN=http://localhost:3000

# Cloudflare Realtime SFU app, for live streams (dash.cloudflare.com → Realtime).
# Keep the secret here, never in the web app. Streaming is off when unset.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# Monthly cap on streaming video (GB). Cloudflare gives 1,000 GB/month free;
# streaming stops at this estimate so it never starts costing. Default 900.
STREAM_BUDGET_GB=900
