# Where the browser finds the signaling server (apps/signaling).
# Inlined at build time, so set it before `next build`.
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000

# Optional TURN relay, for networks where a direct connection is impossible.
# Leave empty to use free public STUN servers only.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
